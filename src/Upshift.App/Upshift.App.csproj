<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Upshift.App</RootNamespace>
    <AssemblyName>Upshift</AssemblyName>
    <Product>Upshift</Product>
    <!-- The version is set in Directory.Build.props at the top of the repo. -->
    <ApplicationIcon>Assets\Upshift.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: runs as a normal .exe, no MSIX install needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without it, "dotnet publish" leaves out Upshift.pri and the compiled XAML (.xbf), and the app can't start. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Main is in Program.cs, so Velopack's install/uninstall hooks run before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows App SDK 1.8 (the metapackage 1.8.260921001's exact versions; move them together), only the parts
      Upshift uses. The metapackage also brings AI, ML (onnxruntime, DirectML) and Widgets, and its Runtime package
      makes a self-contained build unpack the whole framework MSIX, all of that included. Without them, the build
      copies only these components' files.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Installer, uninstaller and self-updates from GitHub Releases. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Upshift.Core\Upshift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo and icons: the window/taskbar icon is loaded from here, and the title bar and About show the SVG. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    "Pre-build shaders" (experimental): the native recorder (upshift_rec.asi) and pre-build program (upshift_prebuild.exe)
    from ..\Upshift.ShaderPrebuild, copied to ShaderPrebuild\ next to Upshift.exe. Visual Studio's MSBuild builds them
    here (always Release x64). The dotnet CLI can't build C++ projects, so build\package.ps1 builds them first with
    Visual Studio's MSBuild and this only copies them; when they're missing, the app says the feature isn't available.
  -->
  <PropertyGroup>
    <NativeDir>$(MSBuildThisFileDirectory)..\Upshift.ShaderPrebuild\</NativeDir>
    <NativeOut>$(NativeDir)bin\x64\Release\</NativeOut>
  </PropertyGroup>
  <Target Name="BuildShaderPrebuild" BeforeTargets="Build" Condition="'$(MSBuildRuntimeType)' == 'Full'">
    <MSBuild Projects="$(NativeDir)Upshift.ShaderPrebuild.vcxproj;$(NativeDir)Upshift.ShaderRecorder.vcxproj"
             Properties="Configuration=Release;Platform=x64" Targets="Build" />
  </Target>
  <Target Name="CopyShaderPrebuild" AfterTargets="Build">
    <Copy SourceFiles="$(NativeOut)upshift_prebuild.exe;$(NativeOut)upshift_rec.asi" DestinationFolder="$(OutDir)ShaderPrebuild"
          SkipUnchangedFiles="true" Condition="Exists('$(NativeOut)upshift_rec.asi') And Exists('$(NativeOut)upshift_prebuild.exe')" />
  </Target>
  <Target Name="PublishShaderPrebuild" AfterTargets="Publish">
    <Copy SourceFiles="$(NativeOut)upshift_prebuild.exe;$(NativeOut)upshift_rec.asi" DestinationFolder="$(PublishDir)ShaderPrebuild"
          Condition="Exists('$(NativeOut)upshift_rec.asi') And Exists('$(NativeOut)upshift_prebuild.exe')" />
  </Target>

</Project>
