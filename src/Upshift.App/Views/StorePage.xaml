<Page
    x:Class="Upshift.App.Views.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Upscaler Store" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                       Text="Upscalers, forks and test projects. What Upshift installs comes from the author's own GitHub release, checked, and comes out again exactly." />
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleSwitch x:Name="FitsSwitch" Header="Works on my PC" IsOn="True" Toggled="Filter_Changed" AutomationProperties.Name="Works on my PC" />
            <ComboBox x:Name="StatusBox" Grid.Column="1" Header="Status" MinWidth="150" SelectionChanged="Filter_Changed" AutomationProperties.Name="Status filter">
                <ComboBoxItem Content="All" Tag="" IsSelected="True" />
                <ComboBoxItem Content="Stable" Tag="Stable" />
                <ComboBoxItem Content="Beta" Tag="Beta" />
                <ComboBoxItem Content="Experimental" Tag="Experimental" />
            </ComboBox>
            <ComboBox x:Name="TypeBox" Grid.Column="2" Header="Type" MinWidth="200" SelectionChanged="Filter_Changed" AutomationProperties.Name="Type filter">
                <ComboBoxItem Content="All" Tag="" IsSelected="True" />
                <ComboBoxItem Content="Installs into a game" Tag="recipe" />
                <ComboBoxItem Content="Runs the author's setup" Tag="author-setup" />
                <ComboBoxItem Content="You supply the file" Tag="user-supplied" />
                <ComboBoxItem Content="Built into Upshift" Tag="builtin" />
                <ComboBoxItem Content="Link only" Tag="link-only" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="3" Header="Search" PlaceholderText="Name, author, description…" TextChanged="Search_Changed"
                     AutomationProperties.Name="Search the store" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <ScrollViewer>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CountText" Foreground="{StaticResource SubtleTextBrush}" />
                    <GridView x:Name="Cards" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Card_Click"
                              AutomationProperties.Name="Store entries" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" CornerRadius="8" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer>
                    <StackPanel x:Name="Detail" Spacing="10" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
