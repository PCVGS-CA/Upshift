<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Upshift.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hw="using:Upshift.Core.Hardware"
    Background="Transparent">

    <ScrollViewer x:Name="PageScroller">
        <StackPanel Padding="40,28,40,40" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <TextBlock Text="Graphics cards Windows reports" FontWeight="SemiBold" />
                <ItemsControl x:Name="GpuList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="hw:GpuInfo">
                            <Grid Margin="0,0,0,8" Padding="16,12" CornerRadius="8" ColumnSpacing="16"
                                  Background="{StaticResource CardSurfaceBrush}"
                                  BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Generation}" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind DriverVersion}" FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="When there is more than one, the dedicated card is used to decide which DLSS 5 option to offer." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Updates" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="AutoCheckSwitch" Header="Check for updates automatically" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="At start-up, Upshift checks GitHub for a newer version of itself and, at most every 6 hours, reads each component's release list. Nothing is installed into games unless you choose to update them, and Upshift only updates itself when you press Update on its row at the top of the Updates page (or Restart to update)." />
                <TextBlock Text="Catalog address (catalogUrl)" Margin="0,6,0,0" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="Upshift reads its list of downloads, DLSS names and advice from its online catalog on GitHub, so fixes arrive without an app update. A newer, valid catalog is used from the next start; when it can't be reached, the copy built into the app is used. Leave this empty for Upshift's catalog, or enter another address." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="CatalogUrlBox" Width="360" PlaceholderText="Empty: Upshift's online catalog" />
                    <Button Content="Save" Click="SaveCatalogUrl_Click" />
                </StackPanel>
                <TextBlock x:Name="CatalogStatusText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Cover art" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="Covers come from Steam, GOG, Epic and the Steam store without signing in. Optionally, add a SteamGridDB API key (from steamgriddb.com, Preferences, API) to fill in the rest. It's only used when nothing else has a cover." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PasswordBox x:Name="SteamGridDbKeyBox" Width="360" PlaceholderText="SteamGridDB API key (optional)" />
                    <Button Content="Save" Click="SaveSteamGridDbKey_Click" />
                </StackPanel>
                <TextBlock x:Name="SteamGridDbStatusText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Measure performance" FontWeight="SemiBold" />
                <ComboBox x:Name="MeasureKeyBox" Header="Key that starts a measurement while a game runs" MinWidth="240"
                          SelectionChanged="MeasureKey_Changed" AutomationProperties.Name="Key that starts a measurement" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="Pick a key the game doesn't use. OptiScaler's keys (Insert, Page Up, Page Down, End, Home) aren't offered. Measuring uses PresentMon, Intel's frame-timing tool (MIT licence), downloaded from its GitHub page the first time. Windows asks for permission each time unless your account is in the Performance Log Users group." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Optional files you supply" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="The app never downloads or bundles these. Point it at a copy you already have and it's copied into the app's own folder." />
                <StackPanel x:Name="UserFileRows" Spacing="10" />
            </StackPanel>

            <!-- Developer options: shown only when Settings is opened with Shift held (or while a pretend card is set) -->
            <StackPanel x:Name="DeveloperPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Developer options" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="Preview the DLSS 5 screens and a game's OptiScaler options (FSR 4, DLSS models) as they look with another graphics card. Nothing is installed or changed while a pretend card is set, and it's forgotten when Upshift closes." />
                <ComboBox x:Name="PretendGpuBox" Header="Pretend this PC has" MinWidth="320" SelectionChanged="PretendGpu_Changed"
                          AutomationProperties.Name="Pretend this PC has" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="App data" FontWeight="SemiBold" />
                <TextBlock x:Name="DataDirText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Open data folder" Click="OpenDataFolder_Click" />
                    <Button Content="Forget scanned games" Click="ClearCache_Click" />
                </StackPanel>
                <TextBlock x:Name="CacheStatusText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Hidden games" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Text="Games you hid with right-click, Hide from library. They're still scanned; they just don't show up." />
                <Expander x:Name="HiddenExpander" Header="Show hidden games" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="HiddenRows" Spacing="6" />
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
