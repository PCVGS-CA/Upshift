<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Upshift.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer x:Name="PageScroller">
        <StackPanel Padding="40,28,40,40" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Updates" FontSize="26" FontWeight="SemiBold" />
                    <!-- One line: "Checked <time> · <n> updates available"; the full result of the last check is in its tooltip -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="CheckingRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="CheckStatusText" FontSize="13" />
                    </StackPanel>
                    <TextBlock x:Name="CatalogText" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CheckNowButton" Click="CheckNow_Click" VerticalAlignment="Top"
                        AutomationProperties.Name="Check now">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Check now" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="RateLimitBar" IsClosable="False" Severity="Warning" Title="Can't check right now" Visibility="Collapsed" />

            <!-- Upshift itself, in the same style as the component rows -->
            <Border CornerRadius="8" Padding="16,12" Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                <StackPanel x:Name="AppRowPanel" />
            </Border>

            <!-- Games with an OptiScaler from this app that a newer release can replace -->
            <Border x:Name="GamesBorder" CornerRadius="8" Padding="16,12" Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                <StackPanel x:Name="GamesPanel" Spacing="6" />
            </Border>

            <!-- Games whose DLSS file is older than the newest one Upshift offers (anti-cheat games left out) -->
            <Border x:Name="DlssBorder" CornerRadius="8" Padding="16,12" Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                <StackPanel x:Name="DlssPanel" Spacing="6" />
            </Border>

            <TextBlock Text="Used now" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel x:Name="UsedNowPanel" Spacing="6" />

            <Expander x:Name="LaterExpander" Header="Game upscaler files (DLSS, FSR, XeSS)" IsExpanded="False" Margin="0,8,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="LaterPanel" Spacing="6" />
            </Expander>

            <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                       Text="Everything comes from each project's own GitHub releases; nothing is re-hosted. Stable is the version this app was tested with; Beta is the newest release, pre-releases included." />
        </StackPanel>
    </ScrollViewer>
</Page>
