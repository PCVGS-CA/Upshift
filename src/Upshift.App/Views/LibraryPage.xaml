<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Upshift.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Upshift.App.ViewModels"
    xmlns:views="using:Upshift.App.Views"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ChipViewModel">
            <Border Background="{x:Bind Background}" CornerRadius="4" Padding="4,1,4,2" Margin="0,0,3,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{x:Bind Text}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind Foreground}" />
                    <!-- Upshift updated one of this technology's files -->
                    <FontIcon Glyph="&#xE74A;" FontSize="8" FontWeight="Bold" Foreground="{x:Bind Foreground}" VerticalAlignment="Center"
                              Visibility="{x:Bind Updated}" ToolTipService.ToolTip="Updated by Upshift" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameCardTemplate" x:DataType="vm:GameCardViewModel">
            <StackPanel Width="146" Spacing="6" Padding="4,4,4,8" Background="Transparent"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Choose picture…" Tag="{x:Bind}" Click="ChoosePicture_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Reset picture" Tag="{x:Bind}" Click="ResetPicture_Click"
                                        IsEnabled="{x:Bind HasCustomArtwork, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE777;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Hide from library" Tag="{x:Bind}" Click="HideGame_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED1A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <Grid Height="196" CornerRadius="8" Background="{x:Bind TileBrush}" Opacity="{x:Bind TileOpacity}">
                    <!-- Title tile, shown when there is no cover art -->
                    <StackPanel VerticalAlignment="Bottom" Margin="12" Spacing="6">
                        <Border Width="22" Height="2" HorizontalAlignment="Left" Background="#B3FFFFFF" />
                        <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="16" FontWeight="Bold"
                                   TextWrapping="WrapWholeWords" MaxLines="4" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Cover art -->
                    <Border CornerRadius="8" Visibility="{x:Bind HasArtwork, Mode=OneWay}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <!-- Badges, stacked at the top left so two never overlap on the narrow card:
                         "OptiScaler" / "Blocked", then "Needs repair", "Update" (a newer OptiScaler on the user's channel)
                         or "Upscaler update" (a newer DLSS, FSR or XeSS file can replace one of the game's) -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Spacing="4">
                        <Border Visibility="{x:Bind HasBadge}" Background="White" CornerRadius="11" Padding="8,2,8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{x:Bind BadgeForeground}" />
                        </Border>
                        <!-- Wraps onto a second line on the narrow card, e.g. "DLSS + FSR + XeSS updates" -->
                        <Border Visibility="{x:Bind HasStatusBadge, Mode=OneWay}" Background="{StaticResource UpshiftAccentBrush}" CornerRadius="10"
                                Padding="8,2,8,3" HorizontalAlignment="Left" MaxWidth="126" ToolTipService.ToolTip="{x:Bind StatusBadgeTip, Mode=OneWay}">
                            <TextBlock Text="{x:Bind StatusBadgeText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <!-- Play, shown while the pointer is over the card -->
                    <Button x:Name="PlayOverlay" Visibility="Collapsed" Tag="{x:Bind}" Click="CardPlay_Click"
                            Width="40" Height="40" CornerRadius="20" Padding="0" Margin="8"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{StaticResource UpshiftAccentBrush}" BorderThickness="0"
                            AutomationProperties.Name="Play" ToolTipService.ToolTip="{x:Bind PlayTip}">
                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                    </Button>
                </Grid>
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind SourceText}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Fsr4Text}" Visibility="{x:Bind HasFsr4Text}" FontSize="11" TextWrapping="Wrap" MaxLines="2"
                           Foreground="{StaticResource SubtleTextBrush}" ToolTipService.ToolTip="{x:Bind Fsr4Text}" />
                <ItemsControl ItemsSource="{x:Bind Tags, Mode=OneWay}" ItemTemplate="{StaticResource ChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpscalerRowTemplate" x:DataType="vm:UpscalerRowViewModel">
            <Grid ColumnSpacing="14" Padding="14,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{x:Bind Chip.Background}" CornerRadius="4" Padding="6,1,6,2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Chip.Text}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind Chip.Foreground}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Feature}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                    <!-- "Update available: 310.9.1 (DLSS 4.5)" -->
                    <TextBlock Text="{x:Bind UpdateNote}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource UpshiftAccentBrush}" Visibility="{x:Bind HasUpdateNote}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Version}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- One row of "Upscaler files": the file, what it is, current → newer version, and its Update button -->
        <DataTemplate x:Key="UpscalerFileTemplate" x:DataType="vm:UpscalerFileRowViewModel">
            <Grid ColumnSpacing="14" Padding="14,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{x:Bind Chip.Background}" CornerRadius="4" Padding="6,1,6,2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{x:Bind Chip.Text}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind Chip.Foreground}" />
                        <FontIcon Glyph="&#xE74A;" FontSize="9" FontWeight="Bold" Foreground="{x:Bind Chip.Foreground}" VerticalAlignment="Center"
                                  Visibility="{x:Bind Chip.Updated}" ToolTipService.ToolTip="Updated by Upshift" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <!-- "3.1.1 (DLSS 3) → 310.9.1 (DLSS 4.5)" -->
                    <TextBlock Text="{x:Bind VersionText}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Path}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="{x:Bind Status}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource SubtleTextBrush}" Visibility="{x:Bind HasStatus}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{x:Bind UpdateLabel}" Tag="{x:Bind}" Click="UpdateFile_Click"
                            Visibility="{x:Bind CanUpdate}" AutomationProperties.Name="{x:Bind UpdateName}" />
                    <Button Content="Restore original" Tag="{x:Bind}" Click="RestoreFile_Click"
                            Visibility="{x:Bind CanRestore}" AutomationProperties.Name="{x:Bind RestoreName}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="670" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Game grid ================= -->
        <Grid Padding="24,16,12,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Library" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <SplitButton Grid.Column="1" Command="{x:Bind ViewModel.ScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Scan for games" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Scan all drives (slower)" Command="{x:Bind ViewModel.DeepScanCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDA2;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Add a game folder…" Click="AddFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>

            <!-- After a newer DLSS file finished downloading: how many games could use it -->
            <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasDlssNotice, Mode=OneWay}" Severity="Success"
                     Title="{x:Bind ViewModel.DlssNotice, Mode=OneWay}" Closed="DlssNotice_Closed"
                     Visibility="{x:Bind ViewModel.HasDlssNotice, Mode=OneWay}" AutomationProperties.Name="DLSS notice">
                <InfoBar.ActionButton>
                    <Button Content="Review" Click="DlssNoticeReview_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBox Grid.Row="2"
                     PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Scrolls sideways when the window is narrow -->
            <ScrollViewer Grid.Row="3" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <SelectorBar x:Name="FilterBar" SelectionChanged="FilterBar_SelectionChanged">
                    <SelectorBarItem Text="All" IsSelected="True" />
                    <SelectorBarItem Text="Upscalers" ToolTipService.ToolTip="Games with DLSS, FSR or XeSS" />
                    <SelectorBarItem Text="OptiScaler" ToolTipService.ToolTip="Games with OptiScaler found in their folder" />
                    <SelectorBarItem Text="Blocked" ToolTipService.ToolTip="Games with anti-cheat: nothing is installed or updated" />
                    <SelectorBarItem Text="Suggestions" ToolTipService.ToolTip="Games with suggestions from the OptiScaler wiki" />
                    <SelectorBarItem Text="Updates" ToolTipService.ToolTip="Updates available: a newer OptiScaler can be installed" />
                    <!-- Names what's out of date across the library, e.g. "DLSS + XeSS updates (7)" -->
                    <SelectorBarItem Text="{x:Bind ViewModel.UpscalerFilterLabel, Mode=OneWay}"
                                     ToolTipService.ToolTip="{x:Bind ViewModel.UpscalerFilterTip, Mode=OneWay}" />
                </SelectorBar>
            </ScrollViewer>

            <Grid Grid.Row="4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelScanCommand}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>

            <GridView Grid.Row="5" x:Name="GamesGrid"
                      ItemsSource="{x:Bind ViewModel.Games}"
                      ItemTemplate="{StaticResource GameCardTemplate}"
                      SelectionMode="Single"
                      SelectionChanged="GamesGrid_SelectionChanged"
                      Padding="0,0,0,24" />

            <StackPanel Grid.Row="5" Visibility="{x:Bind ViewModel.HasNoGames, Mode=OneWay}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="320">
                <TextBlock Text="No games to show" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                           Text="Try a different filter, scan all drives, or add a game folder yourself from the Scan menu." />
            </StackPanel>
        </Grid>

        <!-- ================= Details pane ================= -->
        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <StackPanel Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="Pick a game" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Its upscalers, graphics API and install options show up here."
                               Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>

                <ScrollViewer x:Name="DetailsScroller" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Padding="32,28,32,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Selected.SourceText, Mode=OneWay}" FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="30"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Play_Click"
                                        VerticalAlignment="Center" Padding="18,8" AutomationProperties.Name="Play"
                                        IsEnabled="{x:Bind ViewModel.CanPlaySelected, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Selected.PlayTip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Play" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Selected.TargetText, Mode=OneWay}" FontFamily="Consolas"
                                       FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            <InfoBar IsOpen="{x:Bind ViewModel.Selected.HasLaunchError, Mode=OneWay}" Severity="Error"
                                     Title="The game didn't start" Message="{x:Bind ViewModel.Selected.LaunchError, Mode=OneWay}"
                                     Closed="LaunchError_Closed" />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="14,12" CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Graphics API" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.ApiText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Engine" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.EngineText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Build" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.BuildText, Mode=OneWay}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="14,12" CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Anti-cheat" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.AntiCheatText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="10" Padding="14,10" CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                                    <Run Text="Main game file" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.Selected.ExeNote, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.Selected.ExeText, Mode=OneWay}" FontFamily="Consolas" FontSize="13"
                                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Use automatic" Click="UseAutomaticExe_Click" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.Selected.ExeChosenByUser, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                            <Button Grid.Column="2" Content="Change…" Click="ChangeExe_Click" VerticalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Spacing="6" Margin="0,-10,0,0" Padding="14,10" CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <TextBlock Text="Launch options" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="LaunchOptionsBox" Text="{x:Bind ViewModel.Selected.LaunchOptions, Mode=OneWay}"
                                     IsEnabled="{x:Bind ViewModel.Selected.TakesLaunchOptions, Mode=OneWay}"
                                     PlaceholderText="e.g. -dx12" FontFamily="Consolas" AutomationProperties.Name="Launch options"
                                     LostFocus="LaunchOptions_LostFocus" KeyDown="LaunchOptions_KeyDown" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.LaunchOptionsNote, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>

                        <InfoBar IsOpen="{x:Bind ViewModel.Selected.HasAntiCheat, Mode=OneWay}" IsClosable="False"
                                 Severity="Warning" Title="Installs are blocked for this game"
                                 Message="{x:Bind ViewModel.Selected.AntiCheatMessage, Mode=OneWay}" />

                        <!-- A newer DLSS file for this game: "DLSS 4.5 (310.9.1) is ready for this game. It has 3.1.1 (DLSS 3)…" -->
                        <InfoBar IsOpen="{x:Bind ViewModel.Selected.HasDlssBar, Mode=OneWay}" IsClosable="False" Severity="Success"
                                 Title="DLSS update" Message="{x:Bind ViewModel.Selected.DlssBarText, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.Selected.HasDlssBar, Mode=OneWay}" AutomationProperties.Name="DLSS update">
                            <InfoBar.ActionButton>
                                <Button Content="Update DLSS" Style="{StaticResource AccentButtonStyle}" Click="UpdateDlss_Click"
                                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Upscalers in this game" FontWeight="SemiBold" />
                            <!-- Suggestion only: which upscaler and frame generation suit this card, and what the wiki says to pick in-game -->
                            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.Selected.HasRecommendation, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{StaticResource UpshiftAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.Recommendation.Upscaler, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- The notes: the first three lines, then "Show all" (remembered across restarts) -->
                                <TextBlock x:Name="RecommendationNotes" Text="{x:Bind ViewModel.Selected.Recommendation.Notes, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="22,0,0,0" IsTextTrimmedChanged="RecommendationNotes_TrimmedChanged" />
                                <HyperlinkButton x:Name="RecommendationShowAll" Content="Show all" FontSize="12" Padding="0" Margin="22,2,0,4"
                                                 Visibility="Collapsed" Click="RecommendationShowAll_Click" />
                            </StackPanel>
                            <Border CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    Visibility="{x:Bind ViewModel.Selected.Upscalers.HasRows, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Upscalers.Rows, Mode=OneWay}"
                                              ItemTemplate="{StaticResource UpscalerRowTemplate}" />
                            </Border>
                            <TextBlock Visibility="{x:Bind ViewModel.Selected.Upscalers.HasNoRows, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Text="No DLSS, FSR or XeSS in the game files or on PCGamingWiki. OptiScaler can still add FSR, XeSS and frame generation to many DirectX 11 and 12 games." />
                            <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="{x:Bind ViewModel.Selected.Upscalers.PageUri, Mode=OneWay}"
                                           Foreground="{StaticResource SubtleTextBrush}">Some details from PCGamingWiki</Hyperlink><Run Text="{x:Bind ViewModel.Selected.Upscalers.FooterSuffix, Mode=OneWay}" />
                            </TextBlock>
                            <Expander x:Name="FilesExpander" Header="Show files" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="False"
                                      Visibility="{x:Bind ViewModel.Selected.Upscalers.HasFiles, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Upscalers.Files, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"
                                                       TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>

                        <!-- ================= Upscaler files: newer DLSS / FSR / XeSS files for the ones the game ships ================= -->
                        <!-- Collapsed by default: the DLSS bar and the Updates page checklist are the main way to update. -->
                        <Expander x:Name="UpscalerFilesExpander" Visibility="{x:Bind ViewModel.Selected.HasUpscalerFiles, Mode=OneWay}" IsExpanded="False"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="Upscaler files (advanced)">
                            <Expander.Header>
                                <StackPanel Spacing="2" Padding="0,8">
                                    <TextBlock Text="Upscaler files (advanced)" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.UpscalerFilesSummary, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Expander.Header>
                        <StackPanel Spacing="8">
                            <InfoBar IsOpen="{x:Bind ViewModel.Selected.HasAntiCheatFilesWarning, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                     Title="Anti-cheat in this game" Message="{x:Bind ViewModel.Selected.AntiCheatFilesWarning, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.Selected.HasAntiCheatFilesWarning, Mode=OneWay}" />
                            <InfoBar IsOpen="{x:Bind ViewModel.Selected.HasRestoredByGame, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                     Title="{x:Bind ViewModel.Selected.RestoredTitle, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.Selected.RestoredText, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.Selected.HasRestoredByGame, Mode=OneWay}">
                                <InfoBar.ActionButton>
                                    <Button Content="Re-apply" Click="Reapply_Click"
                                            IsEnabled="{x:Bind ViewModel.Selected.CanReapply, Mode=OneWay}" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <Border CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    Visibility="{x:Bind ViewModel.Selected.HasUpscalerFileRows, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.UpscalerFiles, Mode=OneWay}"
                                              ItemTemplate="{StaticResource UpscalerFileTemplate}"
                                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.Selected.IsAlreadyUpToDate, Mode=OneWay}">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource UpshiftAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Already up to date" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Selected.OptiScalerFilesNote, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Selected.HasOptiScalerFilesNote, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.BuiltInFsrNote, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Selected.HasBuiltInFsrNote, Mode=OneWay}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Selected.HasDlssFrameGenFile, Mode=OneWay}"
                                       Text="nvngx_dlssg.dll (DLSS Frame Generation) isn't updated: it's paired with the game's own Streamline version." />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="{x:Bind ViewModel.Selected.UpdateAllText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                        Click="UpdateAllFiles_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.Selected.CanUpdateAnyFile, Mode=OneWay}" AutomationProperties.Name="Update all" />
                                <Button Content="Restore original files" Click="RestoreFiles_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.Selected.CanRestoreFiles, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                                       Text="Newer files come straight from NVIDIA's, AMD's and Intel's GitHub pages and must carry their digital signature. Only files the game already has are replaced, and each original is backed up in the game's .upshift folder first." />
                        </StackPanel>
                        </Expander>

                        <views:SuggestionsView x:Name="SuggestionsPanel" Card="{x:Bind ViewModel.Selected, Mode=OneWay}" />

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Selected.HasMods, Mode=OneWay}">
                            <TextBlock Text="Already in the game folder" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Mods, Mode=OneWay}" />
                        </StackPanel>

                        <Border CornerRadius="8" Padding="16,14" Background="{StaticResource CardSurfaceBrush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                Visibility="{x:Bind ViewModel.Selected.IsInstalledByUs, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#0D5A44" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.InstalledText, Mode=OneWay}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Selected.Fsr4Text, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.Selected.HasFsr4Text, Mode=OneWay}" />
                                <TextBlock Text="In game: press Insert to open the OptiScaler menu" FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                                <InfoBar IsOpen="{x:Bind ViewModel.Selected.NeedsRepair, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                         Title="Needs repair" Message="{x:Bind ViewModel.Selected.RepairText, Mode=OneWay}">
                                    <InfoBar.ActionButton>
                                        <Button Content="Repair" Click="Repair_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.BusyReason, Mode=OneWay}" />
                                    </InfoBar.ActionButton>
                                    <!-- While another task runs, say why Repair is off -->
                                    <TextBlock Text="{x:Bind ViewModel.BusyReason, Mode=OneWay}" FontSize="12" Margin="0,0,0,8"
                                               Visibility="{x:Bind ViewModel.HasBusyReason, Mode=OneWay}" />
                                </InfoBar>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="{x:Bind ViewModel.Selected.UpdateButtonText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                            Click="Update_Click" Visibility="{x:Bind ViewModel.Selected.HasUpdate, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                                    <Button Content="{x:Bind ViewModel.Selected.UndoText, Mode=OneWay}" Click="Undo_Click"
                                            Visibility="{x:Bind ViewModel.Selected.CanUndo, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                                    <Button Content="Uninstall" Click="Uninstall_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                                    <Button Content="Open OptiScaler.ini" Click="OpenIni_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <views:OptiScalerOptionsView x:Name="OptionsPanel" Card="{x:Bind ViewModel.Selected, Mode=OneWay}" />

                        <!-- DLSS 5 (Neural Rendering): this card's options, the switch to the DLSS 5 build and its settings -->
                        <views:Dlss5View x:Name="Dlss5Panel" Card="{x:Bind ViewModel.Selected, Mode=OneWay}" />

                        <!-- Measure performance: PresentMon for 60 seconds, results and "What to try" (closed by default) -->
                        <views:MeasureView x:Name="MeasurePanel" Card="{x:Bind ViewModel.Selected, Mode=OneWay}" />

                        <!-- Everything Upshift has changed in this game folder right now, with dates -->
                        <!-- Closed by default; the header gives the count and the latest date -->
                        <Expander x:Name="ChangesExpander" Visibility="{x:Bind ViewModel.Selected.HasChanges, Mode=OneWay}" IsExpanded="False"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="Changes Upshift made to this game">
                            <Expander.Header>
                                <StackPanel Spacing="2" Padding="0,8">
                                    <TextBlock Text="Changes Upshift made to this game" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Selected.ChangesSummary, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <Border CornerRadius="8" Background="{StaticResource CardSurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Changes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChangeViewModel">
                                            <Grid ColumnSpacing="14" Padding="14,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Date}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                               Foreground="{StaticResource SubtleTextBrush}" Visibility="{x:Bind HasDetail}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Install OptiScaler" Style="{StaticResource AccentButtonStyle}" Click="Install_Click"
                                    Visibility="{x:Bind ViewModel.Selected.IsNotInstalledByUs, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.Selected.CanInstall, Mode=OneWay}" />
                            <Button Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Open game folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
