<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Upshift.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used only for listing graphics cards (Win32_VideoController). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Opens the .7z archives OptiScaler is released as. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in copy of the catalog. A newer one can be loaded from the "catalogUrl" setting. -->
    <!-- The catalog 1.3+ uses. Catalog\catalog.json is the frozen 1.2.0 catalog that 1.1.0 and 1.2.0 still read from main: never edit or embed it. -->
    <EmbeddedResource Include="Catalog\catalog.v2.json" LogicalName="catalog.json" />
  </ItemGroup>

</Project>
